# Copia in .env.local (sviluppo) o imposta su Vercel → Settings → Environment Variables.
# Nessun valore qui dentro è segreto tranne DECAP_GITHUB_CLIENT_SECRET.

# URL pubblico del sito (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://sbonus.it

# Indicizzazione Google: impostare a 1 SOLO in produzione su sbonus.it
SBONUS_INDEXABLE=

# Google Search Console: solo il valore "content" del meta tag di verifica
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Dati dell'editore mostrati in Privacy / Chi siamo (facoltativi)
NEXT_PUBLIC_EDITOR_ADDRESS=
NEXT_PUBLIC_EDITOR_VAT=

# Google AdSense: lasciare VUOTO finché il sito non è approvato.
# Con il valore vuoto non viene caricato alcuno script e non appare il banner cookie.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENUTO=
NEXT_PUBLIC_ADSENSE_SLOT_ELENCO=

# Pannello redazione /admin (GitHub OAuth App)
DECAP_GITHUB_CLIENT_ID=
DECAP_GITHUB_CLIENT_SECRET=
